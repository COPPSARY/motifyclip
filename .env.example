GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
KIRI_API_KEY=your_key_here
KIRI_STT_MODEL=kiristt
# Optional reliability controls for slow or unstable connections
KIRI_MAX_ATTEMPTS=3
KIRI_REQUEST_TIMEOUT_MS=900000
PORT=8787

# Optional binary/model overrides
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
PYTHON_BIN=python
